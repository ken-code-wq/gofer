# Copy to .env (gitignored). The key is only ever read by the Node server, never sent to the browser.
# SubQ Snap (https://console.subq.ai) — used when set:
SUBQ_API_KEY=
# Or TypeSafe Jev (https://console.typesafe.ai/keys):
# TYPESAFE_API_KEY=

# The "brain" for questions, goals and form filling. Any of these (tried in this order):
# 1) An OpenAI-compatible provider — zai (GLM 5.3 Flash, vision) | deepseek | openrouter | custom
# BRAIN_PROVIDER=zai
# BRAIN_API_KEY=
# BRAIN_MODEL=            # optional override, e.g. deepseek-flash, z-ai/glm-5.3-flash
# BRAIN_BASE_URL=         # custom only
# 2) Google Gemini (free key from https://aistudio.google.com) — also the fallback
GEMINI_API_KEY=
# BRAIN_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite

# Optional
# PORT=8787
# Drive your own Chrome instead of the built-in Chromium (start Chrome with --remote-debugging-port=9333):
# CDP_URL=http://127.0.0.1:9333

# Spend meter: price for a brain model it does not know, in USD per million tokens (input / output).
# BRAIN_PRICE_IN=0.10
# BRAIN_PRICE_OUT=0.40
