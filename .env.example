# Copy to .env (gitignored). The key is only ever read by the Node server, never sent to the browser.
# SubQ Snap (https://console.subq.ai) — used when set:
SUBQ_API_KEY=
# Or TypeSafe Jev (https://console.typesafe.ai/keys):
# TYPESAFE_API_KEY=

# The "brain" for chat, goals, questions and forms. Add keys for as many providers as you like:
# Auto uses the fastest one for each request and switches when one is rate limited.
# Groq (https://console.groq.com/keys): GPT-OSS 120B / 20B, Qwen 3.8 27B (reads screenshots)
GROQ_API_KEY=
# Google Gemini (free key from https://aistudio.google.com): reads screenshots
GEMINI_API_KEY=
# ZAI_API_KEY=            # GLM 5.3 Flash (reads screenshots)
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=     # with OPENROUTER_MODEL=z-ai/glm-5.3-flash (default)
# Older single-provider setting, still honoured and tried first:
# BRAIN_PROVIDER=zai      # zai | deepseek | openrouter | groq | custom
# BRAIN_API_KEY=
# BRAIN_MODEL=
# BRAIN_BASE_URL=         # custom only
# BRAIN_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite

# Optional
# PORT=8787
# Drive your own Chrome instead of the built-in Chromium (start Chrome with --remote-debugging-port=9333):
# CDP_URL=http://127.0.0.1:9333

# Spend meter: price for a brain model it does not know, in USD per million tokens (input / output).
# BRAIN_PRICE_IN=0.10
# BRAIN_PRICE_OUT=0.40
