{
  "name": "gofer",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Gofer: tell your browser what to do. A macOS chat panel that drives Dia, Arc, Chrome or Chromium \u2014 tasks, page and web questions, forms and follow-ups.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "demo": "node scripts/demo.js",
    "demo:ci": "node scripts/demo.js --headless",
    "shots": "node scripts/readme-shots.mjs",
    "test": "node --test 'test/unit/**/*.test.js'",
    "test:integration": "node --test 'test/integration/**/*.test.js'",
    "test:all": "node --test 'test/unit/**/*.test.js' 'test/integration/**/*.test.js'"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "express": "^4.19.2",
    "playwright": "^1.47.0",
    "unpdf": "^1.9.1",
    "ws": "^8.18.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ken-code-wq/gofer.git"
  },
  "homepage": "https://github.com/ken-code-wq/gofer#readme",
  "bugs": {
    "url": "https://github.com/ken-code-wq/gofer/issues"
  },
  "author": "Kenneth Ben-Boulo",
  "contributors": [
    "Moritz Kremb (https://github.com/moritzkremb)"
  ],
  "keywords": [
    "browser-automation",
    "playwright",
    "voice",
    "command-bar",
    "macos",
    "electron",
    "ai-agent",
    "subq",
    "gemini"
  ]
}
