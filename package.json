{
  "name": "voice-browser",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Tell a real browser what to do in plain English: a macOS command bar that drives Chromium, Dia, Arc or Chrome \u2014 clicks, chains, goals, page questions, forms and follow-ups.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "demo": "node scripts/demo.js",
    "demo:ci": "node scripts/demo.js --headless",
    "test": "node --test 'test/unit/**/*.test.js'",
    "test:integration": "node --test 'test/integration/**/*.test.js'",
    "test:all": "node --test 'test/unit/**/*.test.js' 'test/integration/**/*.test.js'"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "express": "^4.19.2",
    "playwright": "^1.47.0",
    "ws": "^8.18.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ken-code-wq/voice-browser.git"
  },
  "homepage": "https://github.com/ken-code-wq/voice-browser#readme",
  "bugs": {
    "url": "https://github.com/ken-code-wq/voice-browser/issues"
  },
  "author": "Kenneth Ben-Boulo",
  "contributors": [
    "Moritz Kremb (https://github.com/moritzkremb)"
  ],
  "keywords": [
    "browser-automation",
    "playwright",
    "voice",
    "command-bar",
    "macos",
    "electron",
    "ai-agent",
    "subq",
    "gemini"
  ]
}
